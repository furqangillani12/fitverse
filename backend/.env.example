# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (from your free M0 cluster)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/fitverse?retryWrites=true&w=majority

# JWT secret for signing auth tokens (use a long random string)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Third-party API keys (fill in as you build each feature) ---

# Nutritionix (meal nutrition data)
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# Google Maps (SOS location)
GOOGLE_MAPS_API_KEY=

# Firebase (auth / push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
